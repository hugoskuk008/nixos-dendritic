{ config, lib, pkgs, ... }:
{
  config = lib.mkIf (config.ai.backend == "llama") {
    #services.llama-swap = {
    #  enable = true;
    #  listenAddress = "127.0.0.1";
    #  openFirewall = false;
    #  port = 8007;
    #  };
    services.llama-cpp = {
    enable = true;
    package = pkgs.llama-cpp-rocm;
    settings = {
    port = 8006;
    models-preset = {

      "Qwen3.5-9b abliterated" = {
          hf-repo = "Abiray/Qwen3.5-9B-abliterated-GGUF";


          hf-file = "Qwen3.5-9B-abliterated-Q8_0.gguf";

          alias = "Qwen3.5";

          temp = "0.8";
          repeat-penalty = "1.05";
          top-k = "80";
          };

        
        };
      };
    };
  };
}

