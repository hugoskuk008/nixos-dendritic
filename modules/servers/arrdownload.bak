{...}:{
flake.modules.nixos.arrstackDownload = {config,pkgs,...}: let
  networkName = "servarrnetwork";
  networkSubnet = "172.39.0.0/24";
  networkUnit = "docker-servarrnetwork";
  vpn-forwarded-port = "38940";

  commonEnv = {
    PUID = "1000";
    PGID = "1000";
    TZ = "Etc/UTC";
  };

  commonOptions = [];
  gluetunNamespace = [ "--network=container:gluetun" ];
in
{
  virtualisation.docker.enable = true;
  virtualisation.oci-containers.backend = "docker";

  sops.templates."gluetun.env".content = ''
    VPN_SERVICE_PROVIDER= wireguard
    VPN_TYPE= airvpn
    WIREGUARD_PUBLIC_KEY_SECRETFILE = ${config.sops.secrets."changeme".path}
    WIREGUARD_PRESHARED_KEY_SECRETFILE = ${config.sops.secrets."changeme".path} 
    WIREGUARD_PRIVATE_KEY_SECRETFILE = ${config.sops.secrets."changeme".path}
    FIREWALL_VPN_INPUT_PORTS=${vpn-forwarded-port}
  '';

  sops.templates."qbittorrent.env".content = ''
    TORRENTING_PORT=${vpn-forwarded-port}
  '';

  systemd.tmpfiles.rules = [
    "d /docker/gluetun 0750 root root - -"
    "d /docker/qbittorrent 0750 root root - -"
    "d /docker/nzbget 0750 root root - -"
    "d /docker/prowlarr 0750 root root - -"
  ];

  systemd.services.${networkUnit} = {
    description = "Create Docker network ${networkName}";
    wantedBy = [ "multi-user.target" ];
    before = [ "docker-gluetun.service" ];
    path = [ pkgs.docker ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      docker network inspect ${networkName} >/dev/null 2>&1 ||
        docker network create --driver bridge --subnet ${networkSubnet} ${networkName}
    '';
  };

  systemd.services.docker-gluetun = {
    requires = [ "${networkUnit}.service" ];
    after = [ "${networkUnit}.service" ];
  };

  virtualisation.oci-containers.containers = {
    gluetun = {
      image = "qmcgaw/gluetun:latest";
      autoStart = true;

      ports = [
        "5010:5010"
        "8080:8080"
        "6881:6881"
        "6789:6789"
        "9696:9696"
        "8191:8191"
      ];

      volumes = [
        "/docker/gluetun:/gluetun"
        "/dev/net/tun:/dev/net/tun"
      ];

      environmentFiles = [
        config.sops.templates."gluetun.env".path
      ];

      capabilities = [ "NET_ADMIN" ];
      devices = [ "/dev/net/tun:/dev/net/tun" ];

      extraOptions = [
        "--network=${networkName}"
      ] ++ commonOptions;
    };

    qbittorrent = {
      image = "lscr.io/linuxserver/qbittorrent:latest";
      autoStart = true;
      dependsOn = [ "gluetun" ];

      environment = commonEnv // {
        WEBUI_PORT = "8080";
      };

      environmentFiles = [
        config.sops.templates."qbittorrent.env".path
      ];

      volumes = [
        "/docker/qbittorrent:/config"
        "/data:/data"
      ];

      extraOptions = gluetunNamespace ++ commonOptions;
    };

    nzbget = {
      image = "lscr.io/linuxserver/nzbget:latest";
      autoStart = true;
      dependsOn = [ "gluetun" ];

      environment = commonEnv;

      volumes = [
        "/docker/nzbget:/config"
        "/data:/data"
      ];

      extraOptions = gluetunNamespace ++ commonOptions;
    };

    prowlarr = {
      image = "lscr.io/linuxserver/prowlarr:latest";
      autoStart = true;
      dependsOn = [ "gluetun" ];

      environment = commonEnv;

      volumes = [
        "/docker/prowlarr:/config"
      ];

      extraOptions = gluetunNamespace ++ commonOptions;
    };
  };

  networking.firewall.allowedTCPPorts = [
    5010
    8080
    6789
    9696
    8191
  ];

  networking.firewall.allowedUDPPorts = [
    6881
  ];



  };
}
